{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "database": "(default)"
  },
  "storage": {
    "rules": "storage.rules",
    "bucket": "toonflow-studio-paint-f76d5.firebasestorage.app"
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  },
  "apphosting": {
    "backendId": "toonflow",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      ".firebase",
      ".env.local",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.log",
      "functions"
    ],
    "alwaysDeployFromSource": true
  }
}
