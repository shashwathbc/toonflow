rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // True when the update touches ONLY the given counter fields
    // (lets readers bump likeCount/viewCount without content write access)
    function onlyUpdates(keys) {
      return isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // A signed-in user may bump likeCount by EXACTLY ±1 (matching the client's
    // increment(±1) in toggleLike). Without the ±1 bound a client could write an
    // arbitrary count (e.g. 999999) straight to the doc. .get(key,0) tolerates
    // legacy docs created before the counter field existed.
    function likeCountBumped() {
      return onlyUpdates(['likeCount'])
        && request.resource.data.likeCount is int
        && (request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
            || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1);
    }

    // A signed-in user may update the rating aggregate ONLY as the setRating
    // transaction does: the average stays in [0,5] and ratingCount moves by at
    // most ±1 (add / change / remove one rating). This blocks the catastrophic
    // manipulation the old unbounded rule allowed (e.g. rating=1, ratingCount=1e5
    // on a rival's work). NOTE: this bounds the *shape* of the write, not its
    // truthfulness — a scripted client could still cast/withdraw one fake vote.
    // Full tamper-proofing requires moving aggregation to an Admin-SDK route
    // (tracked as the P1 rating-integrity follow-up).
    function ratingAdjusted() {
      return onlyUpdates(['rating', 'ratingCount'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
        && request.resource.data.ratingCount is int
        && request.resource.data.ratingCount >= 0
        && (request.resource.data.ratingCount == resource.data.get('ratingCount', 0)
            || request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
            || request.resource.data.ratingCount == resource.data.get('ratingCount', 0) - 1);
    }

    // Public content — anyone can read published novels/webtoons
    match /novels/{novelId} {
      allow read: if true;
      // Author must be the creator, and counters cannot be seeded — viewCount is
      // server-managed and likeCount/rating start at zero (no create-time inflation).
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.viewCount == 0
        && request.resource.data.likeCount == 0;
      // viewCount is server-managed (Admin SDK via /api/views) — clients may not touch it.
      // like/rating bumps are delta-bounded (see likeCountBumped/ratingAdjusted).
      allow update: if isOwner(resource.data.authorId) || isAdmin()
        || likeCountBumped() || ratingAdjusted();
      allow delete: if isOwner(resource.data.authorId) || isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow create, delete: if isOwner(get(/databases/$(database)/documents/novels/$(novelId)).data.authorId) || isAdmin();
        allow update: if isOwner(get(/databases/$(database)/documents/novels/$(novelId)).data.authorId) || isAdmin()
          || likeCountBumped();
      }
    }

    match /webtoons/{webtoonId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.viewCount == 0
        && request.resource.data.likeCount == 0;
      // viewCount is server-managed (Admin SDK via /api/views) — clients may not touch it.
      // like/rating bumps are delta-bounded (see likeCountBumped/ratingAdjusted).
      allow update: if isOwner(resource.data.authorId) || isAdmin()
        || likeCountBumped() || ratingAdjusted();
      allow delete: if isOwner(resource.data.authorId) || isAdmin();

      match /episodes/{episodeId} {
        allow read: if true;
        allow create, delete: if isOwner(get(/databases/$(database)/documents/webtoons/$(webtoonId)).data.authorId) || isAdmin();
        allow update: if isOwner(get(/databases/$(database)/documents/webtoons/$(webtoonId)).data.authorId) || isAdmin()
          || likeCountBumped();
      }
    }

    // User profiles — public read, owner write
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      // Owner may edit ONLY profile fields. balance/role/isCreator/totalEarnings
      // are server-managed via the Admin SDK (which bypasses these rules) — a
      // client must never write them, or a user could self-grant tokens or
      // escalate to superadmin by writing to their own document.
      allow update: if isAdmin()
        || (isOwner(userId) && onlyUpdates(['displayName', 'bio', 'photoURL', 'bannerURL', 'socialLinks', 'updatedAt']))
        // Following someone bumps THEIR followerCount by exactly ±1 (any signed-in
        // user). Bounding the delta stops arbitrary count injection / griefing.
        // .get(key, 0) tolerates legacy docs that predate the counter field.
        || (onlyUpdates(['followerCount'])
            && request.resource.data.followerCount is int
            && (request.resource.data.followerCount == resource.data.get('followerCount', 0) + 1
                || request.resource.data.followerCount == resource.data.get('followerCount', 0) - 1))
        // The follower adjusts their OWN followingCount by exactly ±1.
        || (isOwner(userId) && onlyUpdates(['followingCount'])
            && request.resource.data.followingCount is int
            && (request.resource.data.followingCount == resource.data.get('followingCount', 0) + 1
                || request.resource.data.followingCount == resource.data.get('followingCount', 0) - 1));
      allow delete: if isAdmin();

      // Followers of this user — the doc id IS the follower's uid, so a
      // signed-in user can only ever create/delete their own follow edge and
      // can never follow themselves. One doc per relationship, written inside
      // the follow transaction, means no spam amplification is possible.
      match /followers/{followerId} {
        allow read: if true;
        allow create: if isOwner(followerId) && followerId != userId;
        allow delete: if isOwner(followerId);
      }

      // Who this user follows — only the owner writes their own list, and
      // cannot add themselves.
      match /following/{targetId} {
        allow read: if true;
        allow create: if isOwner(userId) && targetId != userId;
        allow delete: if isOwner(userId);
      }

      // Users this person has blocked — strictly private to the owner. The
      // presence of a block doc gates messaging + re-following elsewhere.
      match /blocked/{blockedId} {
        allow read: if isOwner(userId);
        allow create, delete: if isOwner(userId);
      }

      // Live notifications (follow / like / comment / message). Written
      // cross-user by the ACTOR: the actor is bound to the caller (no
      // impersonation), you can't notify yourself, the type is whitelisted, it
      // starts unread, and the strings are length-capped so a client can't store
      // a huge payload. Only the owner reads their feed. The owner may mark an
      // entry read; the actor may OVERWRITE a message notification (message
      // notifications use a fixed per-conversation id so a thread collapses to
      // one bell entry) but can never clobber a follow/like/comment entry.
      match /notifications/{notificationId} {
        function validNotification() {
          return request.resource.data.actorId == request.auth.uid
            && request.resource.data.read == false
            && request.resource.data.actorName is string
            && request.resource.data.actorName.size() <= 120
            && request.resource.data.link is string
            && request.resource.data.link.size() <= 300
            && request.resource.data.get('targetTitle', '') is string
            && request.resource.data.get('targetTitle', '').size() <= 140
            && request.resource.data.get('preview', '') is string
            && request.resource.data.get('preview', '').size() <= 280;
        }
        allow read: if isOwner(userId);
        allow create: if isSignedIn()
          && request.auth.uid != userId
          && request.resource.data.type in ['follow', 'like', 'comment', 'message']
          && validNotification();
        // (a) owner flips read→true; (b) the actor re-surfaces a message thread
        // by overwriting its (message-typed) entry — never any other type.
        allow update: if (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
            && request.resource.data.read == true)
          || (isSignedIn()
            && request.auth.uid != userId
            && resource.data.type == 'message'
            && request.resource.data.type == 'message'
            && validNotification());
        allow delete: if isOwner(userId);
      }
    }

    // Bookmarks — owner only
    match /bookmarks/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    // Reading history — owner only
    match /readingHistory/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    // Comments — public read, auth write. Author is bound to the caller (no
    // impersonation), likeCount starts at zero, and the body is length-capped
    // so a client can't store multi-megabyte payloads.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 5000;
      allow update: if isOwner(resource.data.authorId) || isAdmin()
        || likeCountBumped();
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    // Follows — auth read, owner write. A user can't follow someone who has
    // blocked them (and can't follow someone they've blocked) — this gate on the
    // flat edge fails the whole follow transaction.
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.followerId
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.followingId)/blocked/$(request.resource.data.followerId))
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.followerId)/blocked/$(request.resource.data.followingId));
      allow delete: if isSignedIn() && request.auth.uid == resource.data.followerId;
    }

    // Transactions — owner read; writes are SERVER ONLY. AI spend (chargeTokens)
    // and coin purchases (Razorpay webhook) are written with the Admin SDK, which
    // bypasses these rules. Blocking client creates stops forged "coin_purchase"
    // history that could be used to social-engineer support or fake balances.
    match /transactions/{txId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Reports — auth create, admin manage
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Support requests — created only via the Admin SDK API route; admin-managed
    match /supportRequests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Withdrawals — owner read/create, admin manage. Amount must be a positive
    // number and status must start 'pending' (a client can't self-approve a payout;
    // admin flips status via the Admin SDK). Balance sufficiency is verified admin-side.
    match /withdrawals/{wId} {
      allow read: if isOwner(resource.data.creatorId) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
    }

    // View tracking — SERVER ONLY (Admin SDK bypasses rules). Clients get no
    // access: view logs, dedup records and analytics must be tamper-proof.
    match /views/{viewId} {
      allow read, write: if false; // legacy collection, retired
    }
    match /chapterViews/{viewId} {
      allow read, write: if false;
    }
    match /viewDedup/{dedupId} {
      allow read, write: if false;
    }
    match /viewStats/{statsId} {
      allow read: if isAdmin();
      allow write: if false;
      match /daily/{day} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
    match /suspiciousViews/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Creator analytics, revenue & view history — reserved for server-side
    // (Admin SDK) aggregation. Clients get creator analytics only through
    // /api/creator/analytics, which scopes results to the verified caller.
    match /creatorAnalytics/{docId} {
      allow read, write: if false;
    }
    match /revenueHistory/{docId} {
      allow read, write: if false;
    }
    match /viewHistory/{docId} {
      allow read, write: if false;
    }

    // Ratings — signed-in users manage their own 1–5 star ratings
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.value is int
        && request.resource.data.value >= 1 && request.resource.data.value <= 5;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.value is int
        && request.resource.data.value >= 1 && request.resource.data.value <= 5;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Likes — signed-in users manage their own likes (uid bound to caller so a
    // like can't be attributed to another user)
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Audit logs — admin read, server write
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // Platform settings — admin read/write
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Messaging ──────────────────────────────────────────────
    // 1:1 conversations. The doc id is the two participant uids sorted and
    // joined with '_'. Only participants can read; STARTING a conversation
    // requires a MUTUAL follow (both follow edges exist), so a user can only
    // message someone who also follows them back. Messages are immutable and
    // bound to their sender.
    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      function mutualFollow(a, b) {
        return exists(/databases/$(database)/documents/follows/$(a + '_' + b))
          && exists(/databases/$(database)/documents/follows/$(b + '_' + a));
      }
      // Neither participant has blocked the other.
      function notBlocked(a, b) {
        return !exists(/databases/$(database)/documents/users/$(a)/blocked/$(b))
          && !exists(/databases/$(database)/documents/users/$(b)/blocked/$(a));
      }

      // A signed-in user may read a conversation they're in — OR probe a
      // non-existent one (resource == null), which getOrCreateConversation must
      // do to decide create-vs-open. A null doc reveals nothing, and the id is
      // derived from the caller's own uid, so this leaks nothing.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);

      // Exactly two DISTINCT participants incl. the creator, no preview yet, a
      // map of unread counters, and the pair must mutually follow.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.lastMessage == null
        && request.resource.data.unreadCount is map
        && mutualFollow(request.resource.data.participants[0], request.resource.data.participants[1])
        && notBlocked(request.resource.data.participants[0], request.resource.data.participants[1]);

      // Either participant bumps the denormalized preview / unread / typing /
      // updatedAt when sending, reading or typing. Participants can't change
      // who's in the chat.
      allow update: if isParticipant()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'unreadCount', 'updatedAt', 'typing']);

      allow delete: if false;

      // Messages — participants read; sender-bound, immutable. A message is
      // either non-empty text (<=5000 chars) OR an image (imageURL) — never a
      // forged sender.
      match /messages/{messageId} {
        function inConversation() {
          return isSignedIn() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read: if inConversation();
        allow create: if inConversation()
          && request.resource.data.senderId == request.auth.uid
          && (
            (request.resource.data.get('type', 'text') == 'image'
              && request.resource.data.imageURL is string
              && request.resource.data.imageURL.size() < 2000)
            || (request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 5000)
          );
        allow update, delete: if false;
      }
    }
  }
}
