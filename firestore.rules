rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // Public content — anyone can read published novels/webtoons
    match /novels/{novelId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.authorId) || isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isOwner(get(/databases/$(database)/documents/novels/$(novelId)).data.authorId) || isAdmin();
      }
    }

    match /webtoons/{webtoonId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.authorId) || isAdmin();

      match /episodes/{episodeId} {
        allow read: if true;
        allow write: if isOwner(get(/databases/$(database)/documents/webtoons/$(webtoonId)).data.authorId) || isAdmin();
      }
    }

    // User profiles — public read, owner write
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Bookmarks — owner only
    match /bookmarks/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    // Reading history — owner only
    match /readingHistory/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    // Comments — public read, auth write
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    // Follows — auth read, owner write
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.followerId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.followerId;
    }

    // Transactions — owner read, server write
    match /transactions/{txId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if isSignedIn();
    }

    // Reports — auth create, admin manage
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Withdrawals — owner read/create, admin manage
    match /withdrawals/{wId} {
      allow read: if isOwner(resource.data.creatorId) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }

    // Views — anyone can create (anon tracking), owner can read
    match /views/{viewId} {
      allow read: if isSignedIn();
      allow create: if true;
    }

    // Likes — signed-in users manage their own likes
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Audit logs — admin read, server write
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // Platform settings — admin read/write
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
