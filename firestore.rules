rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // The super-admin identity taken from the VERIFIED auth token, not from any
    // document a client can write. isAdmin() reads users/{uid}.role, so it can
    // only ever be as trustworthy as every write path to that field — this helper
    // is the one identity check with no such dependency, which is why the
    // role-seeding carve-outs below are keyed to it rather than to isAdmin().
    function isSuperAdminEmail() {
      return isSignedIn() && request.auth.token.email == 'shashwathbc@gmail.com';
    }

    // True when the update touches ONLY the given counter fields
    // (lets readers bump likeCount/viewCount without content write access)
    function onlyUpdates(keys) {
      return isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // A signed-in user may bump likeCount by EXACTLY ±1 (matching the client's
    // increment(±1) in toggleLike). Without the ±1 bound a client could write an
    // arbitrary count (e.g. 999999) straight to the doc. .get(key,0) tolerates
    // legacy docs created before the counter field existed.
    //
    // The ±1 bound alone was NOT enough (audit F-16): nothing tied the counter to
    // the caller's own like, so any signed-in user could simply REPLAY the +1
    // update — a loop of single-field writes drove likeCount arbitrarily high on
    // any story, and the mirror-image -1 loop drove a rival's to zero. Likes feed
    // browse ranking and trending, so that is direct ranking manipulation.
    //
    // The bump is now bound to the caller's like EDGE: likes are stored at the
    // deterministic id `{uid}_{contentType}_{contentId}` (engagement.ts
    // likeDocId), so the rule can name the exact document this caller's like must
    // live at and require that it actually appears (+1) or disappears (-1) in the
    // SAME commit. exists()/existsAfter() compare the before and after state, so
    // a replayed +1 fails: after the first like the edge already exists, and the
    // "did not exist before" half of the test is false. toggleLike already writes
    // both documents in one runTransaction, which is what makes the after-state
    // visible to these rules.
    function likeEdgeAdded(likeId) {
      return !exists(/databases/$(database)/documents/likes/$(likeId))
        && existsAfter(/databases/$(database)/documents/likes/$(likeId));
    }
    function likeEdgeRemoved(likeId) {
      return exists(/databases/$(database)/documents/likes/$(likeId))
        && !existsAfter(/databases/$(database)/documents/likes/$(likeId));
    }
    function likeCountBumped(likeId) {
      return onlyUpdates(['likeCount'])
        && request.resource.data.likeCount is int
        && ((request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
              && likeEdgeAdded(likeId))
            || (request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
              && likeEdgeRemoved(likeId)));
    }
    /** The one like-edge id this caller could legitimately be toggling. */
    function myLikeId(contentType, contentId) {
      return request.auth.uid + '_' + contentType + '_' + contentId;
    }

    // Rating aggregation moved SERVER-SIDE (Admin SDK via /api/ratings) — audit
    // M3. The content doc's rating/ratingCount are now written only by that route
    // (which bypasses these rules and is keyed to the verified session), so the
    // old shape-bounding client rule (ratingAdjusted) is retired: no client may
    // write the aggregate at all.

    // Fields on a novel/webtoon that ONLY the server may write.
    //
    // These were documented as server-managed but never actually enforced on the
    // UPDATE path: `isOwner(resource.data.authorId)` granted an unrestricted
    // write, so the author of a story could set `viewCount` to any number they
    // liked (audit F-15). That is not cosmetic — creator payouts and the
    // /earnings page are computed straight off this field
    // (viewsToCreatorInr(lifetimeViews) in /api/creator/analytics), and browse
    // ranking, trending and the admin "top content" board all sort by it. The
    // same clause let an author write their own `rating`/`ratingCount`, undoing
    // the whole point of moving rating aggregation behind /api/ratings, and let
    // them rewrite `authorId` — the anchor every ownership check in this file
    // keys off, including the Storage path rules.
    //
    // viewCount ← /api/views · rating,ratingCount ← /api/ratings (both Admin SDK,
    // which bypasses these rules entirely). likeCount moves only through the
    // delta-bounded likeCountBumped() clause. Writing the SAME value is not a
    // diff, so legitimate whole-object writes still pass.
    function contentServerFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['viewCount', 'rating', 'ratingCount', 'authorId', 'likeCount']);
    }

    // Public content — anyone can read published novels/webtoons
    match /novels/{novelId} {
      allow read: if true;
      // Author must be the creator, and counters cannot be seeded — viewCount is
      // server-managed and likeCount/rating start at zero (no create-time inflation).
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.viewCount == 0
        && request.resource.data.likeCount == 0;
      // viewCount AND the rating aggregate are server-managed (Admin SDK via
      // /api/views and /api/ratings) — clients may not touch them, which
      // contentServerFieldsUnchanged() now ENFORCES rather than merely asserting.
      // Only the likeCount bump stays client-side and delta-bounded.
      allow update: if ((isOwner(resource.data.authorId) || isAdmin()) && contentServerFieldsUnchanged())
        || likeCountBumped(myLikeId('novel', novelId));
      allow delete: if isOwner(resource.data.authorId) || isAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow create, delete: if isOwner(get(/databases/$(database)/documents/novels/$(novelId)).data.authorId) || isAdmin();
        allow update: if ((isOwner(get(/databases/$(database)/documents/novels/$(novelId)).data.authorId) || isAdmin())
            && contentServerFieldsUnchanged())
          || likeCountBumped(myLikeId('chapter', chapterId));
      }
    }

    match /webtoons/{webtoonId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.viewCount == 0
        && request.resource.data.likeCount == 0;
      // viewCount AND the rating aggregate are server-managed (Admin SDK via
      // /api/views and /api/ratings) — clients may not touch them, which
      // contentServerFieldsUnchanged() now ENFORCES rather than merely asserting.
      // Only the likeCount bump stays client-side and delta-bounded.
      allow update: if ((isOwner(resource.data.authorId) || isAdmin()) && contentServerFieldsUnchanged())
        || likeCountBumped(myLikeId('webtoon', webtoonId));
      allow delete: if isOwner(resource.data.authorId) || isAdmin();

      match /episodes/{episodeId} {
        allow read: if true;
        allow create, delete: if isOwner(get(/databases/$(database)/documents/webtoons/$(webtoonId)).data.authorId) || isAdmin();
        allow update: if ((isOwner(get(/databases/$(database)/documents/webtoons/$(webtoonId)).data.authorId) || isAdmin())
            && contentServerFieldsUnchanged())
          || likeCountBumped(myLikeId('episode', episodeId));
      }

      // Character roster — owner-managed reference sheet for the series.
      match /characters/{characterId} {
        allow read: if true;
        allow write: if isOwner(get(/databases/$(database)/documents/webtoons/$(webtoonId)).data.authorId) || isAdmin();
      }
    }

    // User profiles — public per-document GET, owner write.
    //
    // A user document is not purely public: alongside displayName/photoURL/bio it
    // carries `email`, `balance` and `totalEarnings`. Firestore rules cannot
    // filter FIELDS, so the read rule can only control the granularity of access
    // — and `allow read: if true` covered LIST too, which made the entire
    // collection dumpable by anyone, signed in or not (audit F-17). That is a
    // one-request harvest of every registered email address: the raw material for
    // credential stuffing and targeted phishing, plus every user's wallet balance.
    //
    // Splitting the verbs removes the bulk primitive while keeping every real
    // feature working: profile pages and follower lists read ONE known uid at a
    // time (`get` — see fetchProfiles in lib/firebase/social.ts, rewritten off its
    // `in` query for exactly this reason), and only admins enumerate the
    // collection (`list`). The remaining exposure — someone who already knows a
    // uid can still read that one user's email — needs the fields moved off the
    // document; see the staged `users/{uid}/private/account` migration in
    // SECURITY.md §7.
    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      // CREATE is exactly as security-critical as UPDATE, and used to be wide
      // open: the document doesn't exist yet, so `isOwner(userId)` on its own let
      // the caller SEED any field on the very first write. The app's signup path
      // writes sane values, but nothing forces a caller to use the app — the web
      // API key is public by design, so an attacker calls the Auth REST signUp
      // endpoint directly and writes their own users/{uid} with
      // `role: 'superadmin'` (which isAdmin() then reads, granting write access
      // across the whole database — including `allow update` on withdrawals, i.e.
      // approving their own payout) and a five-figure `balance`. Every
      // server-managed field is therefore pinned to its zero value here, exactly
      // as the update rule pins them afterwards.
      //
      // The sole exception is the super-admin's own first sign-in, which
      // legitimately seeds role/isCreator — keyed to the verified token email, a
      // claim no client can forge.
      allow create: if isOwner(userId)
        && request.resource.data.balance == 0
        && request.resource.data.totalEarnings == 0
        && request.resource.data.totalViews == 0
        && request.resource.data.followerCount == 0
        && request.resource.data.followingCount == 0
        && (request.resource.data.role == 'user' || isSuperAdminEmail())
        && (request.resource.data.isCreator == false || isSuperAdminEmail());
      // Owner may edit ONLY profile fields. balance/role/isCreator/totalEarnings
      // are server-managed via the Admin SDK (which bypasses these rules) — a
      // client must never write them, or a user could self-grant tokens or
      // escalate to superadmin by writing to their own document.
      //
      // isAdmin() deliberately does NOT apply to an admin's own document: it
      // grants unrestricted writes to any users/{id}, so an `admin` (a moderator,
      // not an owner) could promote itself to `superadmin` or credit itself
      // `balance` — turning a moderation account into a payout account. Admins
      // manage OTHER users; on their own doc they fall through to the owner
      // clause below and can edit profile fields only. The super-admin, whose
      // identity comes from the token rather than the database, keeps full reach.
      allow update: if (isAdmin() && (request.auth.uid != userId || isSuperAdminEmail()))
        || (isOwner(userId) && onlyUpdates(['displayName', 'bio', 'photoURL', 'bannerURL', 'socialLinks', 'hasOnboarded', 'referralSource', 'updatedAt']))
        // Following someone bumps THEIR followerCount by exactly ±1 (any signed-in
        // user). Bounding the delta stops arbitrary count injection / griefing.
        // .get(key, 0) tolerates legacy docs that predate the counter field.
        || (onlyUpdates(['followerCount'])
            && request.resource.data.followerCount is int
            && (request.resource.data.followerCount == resource.data.get('followerCount', 0) + 1
                || request.resource.data.followerCount == resource.data.get('followerCount', 0) - 1))
        // The follower adjusts their OWN followingCount by exactly ±1.
        || (isOwner(userId) && onlyUpdates(['followingCount'])
            && request.resource.data.followingCount is int
            && (request.resource.data.followingCount == resource.data.get('followingCount', 0) + 1
                || request.resource.data.followingCount == resource.data.get('followingCount', 0) - 1));
      allow delete: if isAdmin();

      // Followers of this user — the doc id IS the follower's uid, so a
      // signed-in user can only ever create/delete their own follow edge and
      // can never follow themselves. One doc per relationship, written inside
      // the follow transaction, means no spam amplification is possible.
      match /followers/{followerId} {
        allow read: if true;
        allow create: if isOwner(followerId) && followerId != userId;
        allow delete: if isOwner(followerId);
      }

      // Who this user follows — only the owner writes their own list, and
      // cannot add themselves.
      match /following/{targetId} {
        allow read: if true;
        allow create: if isOwner(userId) && targetId != userId;
        allow delete: if isOwner(userId);
      }

      // Users this person has blocked — strictly private to the owner. The
      // presence of a block doc gates messaging + re-following elsewhere.
      match /blocked/{blockedId} {
        allow read: if isOwner(userId);
        allow create, delete: if isOwner(userId);
      }

      // Live notifications (follow / like / comment / message). Written
      // cross-user by the ACTOR: the actor is bound to the caller (no
      // impersonation), you can't notify yourself, the type is whitelisted, it
      // starts unread, and the strings are length-capped so a client can't store
      // a huge payload. Only the owner reads their feed. The owner may mark an
      // entry read; the actor may OVERWRITE a message notification (message
      // notifications use a fixed per-conversation id so a thread collapses to
      // one bell entry) but can never clobber a follow/like/comment entry.
      match /notifications/{notificationId} {
        function validNotification() {
          return request.resource.data.actorId == request.auth.uid
            && request.resource.data.read == false
            && request.resource.data.actorName is string
            && request.resource.data.actorName.size() <= 120
            && request.resource.data.link is string
            && request.resource.data.link.size() <= 300
            // The bell NAVIGATES to this value (router.push). Any signed-in user
            // may write a notification into any other user's feed, so an
            // unconstrained link turns the bell into a one-click redirect to a
            // phishing clone of our own login page — or, for a `javascript:`
            // value, a script sink. Every link the app writes is a rooted in-app
            // path, so require exactly that: a single leading '/', and the next
            // character may not be '/' or '\' (both parse as an authority, i.e.
            // //evil.test). The client re-validates at the sink (safeInternalPath).
            && request.resource.data.link.matches('/[^/\\\\].*')
            && request.resource.data.get('targetTitle', '') is string
            && request.resource.data.get('targetTitle', '').size() <= 140
            && request.resource.data.get('preview', '') is string
            && request.resource.data.get('preview', '').size() <= 280;
        }
        allow read: if isOwner(userId);
        allow create: if isSignedIn()
          && request.auth.uid != userId
          && request.resource.data.type in ['follow', 'like', 'comment', 'message']
          && validNotification();
        // (a) owner flips read→true; (b) the actor re-surfaces a message thread
        // by overwriting its (message-typed) entry — never any other type.
        allow update: if (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
            && request.resource.data.read == true)
          || (isSignedIn()
            && request.auth.uid != userId
            && resource.data.type == 'message'
            && request.resource.data.type == 'message'
            && validNotification());
        allow delete: if isOwner(userId);
      }
    }

    // Bookmarks — owner only
    match /bookmarks/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    // Reading history — owner only
    match /readingHistory/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    // Comments — public read, auth write. Author is bound to the caller (no
    // impersonation), likeCount starts at zero, and the body is length-capped
    // so a client can't store multi-megabyte payloads.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 5000;
      // Editing your own comment must not rewrite its authorship or its like
      // tally — same reasoning as contentServerFieldsUnchanged() above.
      allow update: if ((isOwner(resource.data.authorId) || isAdmin())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorId', 'likeCount']))
        || likeCountBumped(myLikeId('comment', commentId));
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    // Follows — auth read, owner write. A user can't follow someone who has
    // blocked them (and can't follow someone they've blocked) — this gate on the
    // flat edge fails the whole follow transaction.
    match /follows/{followId} {
      allow read: if isSignedIn();
      // The doc ID must BE `{followerId}_{followingId}`. Without this the body was
      // validated but the path was free, so a caller could write the edge
      // `follows/{B}_{A}` while still setting `followerId: A` (their own uid, so
      // the check below passed) — forging the half of the pair that only B can
      // legitimately create. The messaging gate's mutualFollow() is nothing more
      // than `exists(follows/a_b) && exists(follows/b_a)`, so that let anyone DM a
      // stranger who had never followed them back. Binding the ID to the body
      // makes the edge unforgeable, since only B's own uid can mint `{B}_*`.
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.followerId
        && followId == request.resource.data.followerId + '_' + request.resource.data.followingId
        && request.resource.data.followerId != request.resource.data.followingId
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.followingId)/blocked/$(request.resource.data.followerId))
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.followerId)/blocked/$(request.resource.data.followingId));
      allow delete: if isSignedIn() && request.auth.uid == resource.data.followerId;
    }

    // Transactions — owner read; writes are SERVER ONLY. AI spend (chargeTokens)
    // and coin purchases (Razorpay webhook) are written with the Admin SDK, which
    // bypasses these rules. Blocking client creates stops forged "coin_purchase"
    // history that could be used to social-engineer support or fake balances.
    match /transactions/{txId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Reports — auth create, admin manage. `isSignedIn()` alone accepted a
    // document of any shape and any size, so the moderation queue doubled as
    // free unbounded storage and a report could be filed under someone else's
    // reporterId (getting an innocent user blamed for a bad-faith report, or
    // hiding the actual reporter). Bind the reporter to the caller, pin the
    // opening status, whitelist the target type and cap the free-text fields —
    // the same shape createReport() already sends.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.targetType in ['novel', 'webtoon', 'comment', 'user']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() <= 200
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.get('details', '') is string
        && request.resource.data.get('details', '').size() <= 5000;
      allow update, delete: if isAdmin();
    }

    // Support requests — created only via the Admin SDK API route; admin-managed
    match /supportRequests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Withdrawals — owner read/create, admin manage. Amount must be a positive
    // number and status must start 'pending' (a client can't self-approve a payout;
    // admin flips status via the Admin SDK). Balance sufficiency is verified admin-side.
    match /withdrawals/{wId} {
      allow read: if isOwner(resource.data.creatorId) || isAdmin();
      // The upper bound is a sanity rail, not the authorisation: sufficiency
      // against the creator's real balance is verified admin-side before payout.
      // It exists so a client can't file a nonsense 10^12 request that has to be
      // triaged by a human, and so `amount` can't be a non-finite number.
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
    }

    // View tracking — SERVER ONLY (Admin SDK bypasses rules). Clients get no
    // access: view logs, dedup records and analytics must be tamper-proof.
    match /views/{viewId} {
      allow read, write: if false; // legacy collection, retired
    }
    match /chapterViews/{viewId} {
      allow read, write: if false;
    }
    match /viewDedup/{dedupId} {
      allow read, write: if false;
    }
    match /viewStats/{statsId} {
      allow read: if isAdmin();
      allow write: if false;
      match /daily/{day} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
    match /suspiciousViews/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Creator analytics, revenue & view history — reserved for server-side
    // (Admin SDK) aggregation. Clients get creator analytics only through
    // /api/creator/analytics, which scopes results to the verified caller.
    match /creatorAnalytics/{docId} {
      allow read, write: if false;
    }
    match /revenueHistory/{docId} {
      allow read, write: if false;
    }
    match /viewHistory/{docId} {
      allow read, write: if false;
    }

    // Ratings — written ONLY by the Admin SDK via /api/ratings, which recomputes
    // the content aggregate in the same transaction (audit M3). Public read so a
    // signed-in user can see their own star; clients never write here.
    match /ratings/{ratingId} {
      allow read: if true;
      allow write: if false;
    }

    // Likes — signed-in users manage their own likes (uid bound to caller so a
    // like can't be attributed to another user).
    //
    // The document ID is also bound to `{uid}_{contentType}_{contentId}`. Without
    // it the body was checked but the PATH was free, so one user could mint
    // unlimited like edges (likes/{random}) for the same target — and, because
    // the counter rule keys off this exact id, an unbound path would also let the
    // ±1 guard in likeCountBumped() be sidestepped by pointing each write at a
    // fresh edge. Binding the id makes "one like per user per target" a structural
    // property rather than a client-side convention.
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.contentType in ['novel', 'webtoon', 'chapter', 'episode', 'comment', 'artwork', 'product', 'anime']
        && likeId == request.auth.uid + '_' + request.resource.data.contentType + '_' + request.resource.data.contentId;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Audit logs — admin read, server write
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // Platform settings — admin read/write
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Anime Studio ───────────────────────────────────────────
    // Projects are PRIVATE workspaces. Unlike novels/webtoons (public catalog,
    // `allow read: if true`), an anime project is a draft workbench containing
    // prompts and unreleased work, so read access is owner-only until the
    // creator publishes it. `list` is bound to an ownerId == uid query, which is
    // what stops the collection from being enumerable.
    match /animeProjects/{projectId} {
      // Fields the SERVER owns.
      //
      // status/visibility/publishedAt are the PUBLICATION state: flipping them
      // is what puts a title into Browse/Home/Originals AND what makes its clips
      // world-playable through /api/anime/watch. That decision runs through
      // /api/anime/publish, which refuses to publish a project with no generated
      // scene — a client-writable status would walk straight past that check and
      // list a title that plays nothing.
      //
      // viewCount/likeCount are engagement counters that feed catalog ranking,
      // exactly like the novel/webtoon ones (see contentServerFieldsUnchanged).
      // ownerId is the anchor every check below keys off.
      //
      // sceneCount/durationSec stay client-writable: they're cosmetic totals the
      // owner's own session maintains alongside its scene writes, and inflating
      // your own scene count buys nothing.
      function projectServerFieldsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['ownerId', 'status', 'visibility', 'publishedAt', 'viewCount', 'likeCount']);
      }
      function isProjectOwner() {
        return isOwner(resource.data.ownerId);
      }
      function isPubliclyListed() {
        return resource.data.status == 'published' && resource.data.visibility == 'public';
      }

      // Public read for a published title — this is what lets Browse, Home and
      // Originals show anime alongside novels and webtoons. `unlisted` stays
      // link-only: readable by id, never returned by a listing query.
      allow get: if isProjectOwner() || isAdmin()
        || (resource.data.status == 'published' && resource.data.visibility != 'private');
      // Rules can't inspect a query, but they CAN require every returned
      // document to satisfy the condition — so an unfiltered listing simply
      // fails, while the catalog query (published + public) and the owner's own
      // dashboard query both pass.
      allow list: if isPubliclyListed()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.sceneCount == 0
        && request.resource.data.durationSec == 0
        && request.resource.data.viewCount == 0
        && request.resource.data.likeCount == 0
        && request.resource.data.status == 'draft'
        && request.resource.data.visibility == 'private'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description.size() <= 2000;
      allow update: if (isProjectOwner() && projectServerFieldsUnchanged()
          && request.resource.data.title.size() <= 120
          && request.resource.data.description.size() <= 2000
          && request.resource.data.genres.size() <= 5)
        || likeCountBumped(myLikeId('anime', projectId))
        || isAdmin();
      allow delete: if isProjectOwner() || isAdmin();

      // Scenes. The GENERATION-MANAGED fields are the security boundary here:
      // status/storageKey/posterKey/generationJobId/durationSec are written ONLY
      // by the Admin SDK (lib/anime/jobs) after a provider actually returned
      // bytes. If a client could write them it could mark its own scene 'ready'
      // and point storageKey anywhere in the bucket — fabricating a clip and
      // turning /api/anime/assets into a signing oracle for arbitrary objects.
      match /scenes/{sceneId} {
        function generationFieldsUnchanged() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['status', 'storageKey', 'posterKey', 'generationJobId', 'durationSec', 'metadata', 'ownerId']);
        }
        // Public read once the parent project is published — the watch page
        // needs the scene list (titles, order, durations) to build a playlist.
        // Exposing `storageKey` here is safe: it is a PRIVATE object path that
        // no client can fetch, and turning it into a playable URL requires
        // /api/anime/watch, which re-checks publication on every request.
        function parentPublished() {
          return get(/databases/$(database)/documents/animeProjects/$(projectId)).data.status == 'published';
        }
        allow read: if isOwner(resource.data.ownerId) || isAdmin() || parentPublished();
        allow list: if parentPublished()
          || (isSignedIn() && resource.data.ownerId == request.auth.uid);
        allow create: if isSignedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.projectId == projectId
          && request.resource.data.status == 'idle'
          && request.resource.data.storageKey == null
          && request.resource.data.generationJobId == null
          && request.resource.data.durationSec == 0
          && request.resource.data.prompt is string
          && request.resource.data.prompt.size() <= 2000;
        allow update: if isOwner(resource.data.ownerId)
          && generationFieldsUnchanged()
          && request.resource.data.prompt.size() <= 2000;
        allow delete: if isOwner(resource.data.ownerId) || isAdmin();
      }

      // Editor timeline + saved revisions — owner only, both directions.
      // Ownership is read from the PARENT project (these docs carry no ownerId
      // of their own), which is also what stops a stray doc id from creating an
      // ownerless, permanently-writable document.
      match /editor/{docId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/animeProjects/$(projectId)).data.ownerId);
      }
      match /revisions/{revisionId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/animeProjects/$(projectId)).data.ownerId);
      }
    }

    // Reusable characters — strictly private to their creator. They are prompt
    // INPUT, so read access to someone else's character is read access to their
    // unreleased designs.
    match /animeCharacters/{characterId} {
      allow get: if isOwner(resource.data.ownerId) || isAdmin();
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.appearance.size() <= 1000
        && request.resource.data.referenceImages.size() <= 8;
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name.size() <= 80
        && request.resource.data.referenceImages.size() <= 8;
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // Generation jobs — READ-ONLY for the owner, written exclusively by the
    // Admin SDK. This is the single most important write denial in the Anime
    // Studio: a client that could create a job would bypass the entitlement
    // ceilings, the daily quota and the concurrency cap (all enforced in
    // /api/anime/jobs), and one that could UPDATE a job could flip it to
    // 'completed' with a storageKey of its choosing.
    match /generationJobs/{jobId} {
      allow get: if isOwner(resource.data.ownerId) || isAdmin();
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // ── Art Studio & marketplace ───────────────────────────────
    // Artwork is the mirror image of an anime project: private while a draft,
    // world-readable once published. The status flip itself is server-only
    // (/api/art/publish), which is what lets that route re-verify the stored
    // bytes before anything becomes public — a client-settable `status` would
    // route straight around that check.
    match /artworks/{artworkId} {
      function artServerFieldsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['ownerId', 'status', 'visibility', 'publishedAt', 'viewCount', 'likeCount', 'rightsConfirmed']);
      }
      allow get: if resource.data.status == 'published'
        || isOwner(resource.data.ownerId) || isAdmin();
      allow list: if resource.data.status == 'published'
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.visibility == 'private'
        && request.resource.data.rightsConfirmed == false
        && request.resource.data.viewCount == 0
        && request.resource.data.likeCount == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.description.size() <= 2000
        && request.resource.data.tags.size() <= 12;
      allow update: if (isOwner(resource.data.ownerId)
          && artServerFieldsUnchanged()
          && request.resource.data.title.size() <= 120
          && request.resource.data.description.size() <= 2000
          && request.resource.data.tags.size() <= 12)
        || likeCountBumped(myLikeId('artwork', artworkId))
        || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();

      match /editor/{docId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/artworks/$(artworkId)).data.ownerId);
      }
    }

    // Products — public read when published, NO client writes at all. Every
    // field that determines what a buyer pays (variants, prices) is derived
    // server-side in /api/art/products from the catalogue; a client-writable
    // price document is a client-writable invoice.
    match /products/{productId} {
      allow get: if resource.data.status == 'published'
        || isOwner(resource.data.ownerId) || isAdmin();
      allow list: if resource.data.status == 'published'
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create, update: if false;
      // Deleting a draft listing is safe (it removes only the creator's own
      // document and moves no money); published listings come down via the API
      // so dependent orders stay resolvable.
      allow delete: if (isOwner(resource.data.ownerId) && resource.data.status != 'published') || isAdmin();
    }

    // Marketplace view dedup — SERVER ONLY (Admin SDK), same posture as
    // /viewDedup. It holds hashed visitor identifiers, and any client access
    // would let someone probe whether a given visitor saw a listing.
    match /artViewDedup/{dedupId} {
      allow read, write: if false;
    }

    // Orders — buyer/seller read, SERVER-ONLY write. Same posture as
    // /transactions: an order carries payment and fulfilment state, so a client
    // create would be a forged receipt and a client update would be
    // self-marking an order paid or shipped.
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.buyerId == request.auth.uid;
      allow write: if false;
    }

    // Creator earnings ledger — the document a withdrawal is paid against.
    //
    // READ is scoped to the creator the row belongs to. WRITE is denied to
    // everyone, including that creator: `status` is what makes money
    // withdrawable, so a client-writable row would let a creator flip their own
    // pending earnings to `available` (or raise `netMinor`) and withdraw against
    // an order that has not been delivered — or has already been refunded.
    // Every mutation goes through /api/art/orders/transition under the Admin
    // SDK, which re-derives the status from the order itself.
    //
    // `list` is bound to a creatorId == uid query, which is what stops the
    // collection from being enumerable across creators.
    match /creatorEarnings/{earningId} {
      allow get: if isSignedIn()
        && (resource.data.creatorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.creatorId == request.auth.uid;
      allow write: if false;
    }

    // ── Messaging ──────────────────────────────────────────────
    // 1:1 conversations. The doc id is the two participant uids sorted and
    // joined with '_'. Only participants can read; STARTING a conversation
    // requires a MUTUAL follow (both follow edges exist), so a user can only
    // message someone who also follows them back. Messages are immutable and
    // bound to their sender.
    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      function mutualFollow(a, b) {
        return exists(/databases/$(database)/documents/follows/$(a + '_' + b))
          && exists(/databases/$(database)/documents/follows/$(b + '_' + a));
      }
      // Neither participant has blocked the other.
      function notBlocked(a, b) {
        return !exists(/databases/$(database)/documents/users/$(a)/blocked/$(b))
          && !exists(/databases/$(database)/documents/users/$(b)/blocked/$(a));
      }

      // A signed-in user may read a conversation they're in — OR probe a
      // non-existent one (resource == null), which getOrCreateConversation must
      // do to decide create-vs-open. A null doc reveals nothing, and the id is
      // derived from the caller's own uid, so this leaks nothing.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);

      // Exactly two DISTINCT participants incl. the creator, no preview yet, a
      // map of unread counters, and the pair must mutually follow.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.lastMessage == null
        && request.resource.data.unreadCount is map
        && mutualFollow(request.resource.data.participants[0], request.resource.data.participants[1])
        && notBlocked(request.resource.data.participants[0], request.resource.data.participants[1]);

      // Either participant bumps the denormalized preview / unread / typing /
      // updatedAt when sending, reading or typing. Participants can't change
      // who's in the chat.
      allow update: if isParticipant()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'unreadCount', 'updatedAt', 'typing']);

      allow delete: if false;

      // Messages — participants read; sender-bound, immutable. A message is
      // either non-empty text (<=5000 chars) OR an image (imageURL) — never a
      // forged sender.
      match /messages/{messageId} {
        function inConversation() {
          return isSignedIn() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read: if inConversation();
        allow create: if inConversation()
          && request.resource.data.senderId == request.auth.uid
          && (
            (request.resource.data.get('type', 'text') == 'image'
              && request.resource.data.imageURL is string
              && request.resource.data.imageURL.size() < 2000
              // The recipient's thread renders this in an <a href>, so an
              // unconstrained scheme (`javascript:...`) is click-to-execute XSS
              // against the counterparty. Legitimate uploads always come back as
              // an https Storage download URL; require that scheme here and
              // re-validate at the sink (safeHttpUrl in ThreadClient).
              && request.resource.data.imageURL.matches('https://.*'))
            || (request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 5000)
          );
        allow update, delete: if false;
      }
    }
  }
}
