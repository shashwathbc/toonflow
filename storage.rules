rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Explicit allowlist — excludes image/svg+xml, which can carry <script> and
    // is an XSS/scripted-image vector when served inline. Raster formats only.
    function isSafeImage() {
      return request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif)');
    }

    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    function isUnder25MB() {
      return request.resource.size < 25 * 1024 * 1024;
    }

    // Only the novel/webtoon author may write its assets. The content document is
    // created (Admin/client) before any asset upload, so this lookup resolves.
    function ownsNovel(novelId) {
      return isAuth() &&
        firestore.get(/databases/(default)/documents/novels/$(novelId)).data.authorId == request.auth.uid;
    }

    function ownsWebtoon(webtoonId) {
      return isAuth() &&
        firestore.get(/databases/(default)/documents/webtoons/$(webtoonId)).data.authorId == request.auth.uid;
    }

    // User avatars — owner only
    match /users/{uid}/avatar/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSafeImage() && isUnder10MB();
    }

    // User banners — owner only
    match /users/{uid}/banner/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSafeImage() && isUnder10MB();
    }

    // Novel covers — author only (was any authenticated user → cross-user deface)
    match /novels/{novelId}/cover/{file} {
      allow read: if true;
      allow write: if ownsNovel(novelId) && isSafeImage() && isUnder10MB();
    }

    // Novel banners — author only
    match /novels/{novelId}/banner/{file} {
      allow read: if true;
      allow write: if ownsNovel(novelId) && isSafeImage() && isUnder10MB();
    }

    // Webtoon covers — author only
    match /webtoons/{webtoonId}/cover/{file} {
      allow read: if true;
      allow write: if ownsWebtoon(webtoonId) && isSafeImage() && isUnder10MB();
    }

    // Webtoon episode panels (up to 25MB per image) — author only
    match /webtoons/{webtoonId}/episodes/{episodeId}/{file} {
      allow read: if true;
      allow write: if ownsWebtoon(webtoonId) && isSafeImage() && isUnder25MB();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
