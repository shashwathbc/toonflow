rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Explicit allowlist — excludes image/svg+xml, which can carry <script> and
    // is an XSS/scripted-image vector when served inline. Raster formats only.
    function isSafeImage() {
      return request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif)');
    }

    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    function isUnder25MB() {
      return request.resource.size < 25 * 1024 * 1024;
    }

    // NOTE: ownership is proven from the PATH — every content asset is stored
    // under the uploader's uid as the second segment (…/{uid}/…), so writes are
    // gated with isOwner(uid). We deliberately avoid cross-service Firestore
    // reads (firestore.get) from Storage rules: they don't resolve reliably in
    // this project, which silently denied every author's own upload. Reads stay
    // public (assets are referenced by tokenised download URLs).

    // User avatars / banners — owner only
    match /users/{uid}/avatar/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSafeImage() && isUnder10MB();
    }
    match /users/{uid}/banner/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSafeImage() && isUnder10MB();
    }

    // Novel cover + banner — novels/{uid}/{novelId}/cover.ext | banner.ext
    match /novels/{uid}/{novelId}/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSafeImage() && isUnder10MB();
    }

    // Webtoon cover — webtoons/{uid}/{webtoonId}/cover.ext
    match /webtoons/{uid}/{webtoonId}/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSafeImage() && isUnder10MB();
    }

    // Webtoon episode panels (up to 25MB) — webtoons/{uid}/{webtoonId}/{episodeId}/panel_N.ext
    match /webtoons/{uid}/{webtoonId}/{episodeId}/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSafeImage() && isUnder25MB();
    }

    // Direct-message images — conversations/{cid}/{uid}/{file}. Owner-scoped
    // write; public read (the tokenised URL is only stored in the participant-
    // only message doc, so it isn't discoverable without being in the chat).
    match /conversations/{conversationId}/{uid}/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSafeImage() && isUnder10MB();
    }

    // ── Art Studio ────────────────────────────────────────────
    // Public prefix: only ever holds renders/originals the creator intends to
    // show. Publishing re-verifies these bytes server-side (/api/art/publish)
    // before anything is linked from a public page — these rules can only see
    // the DECLARED contentType, which the uploader controls.
    match /artworks/{uid}/{artworkId}/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSafeImage() && isUnder25MB();
    }

    // Composed product mockups shown on marketplace listings.
    match /products/{uid}/{productId}/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSafeImage() && isUnder10MB();
    }

    // Anime character reference sheets — owner write, public read (they appear
    // on the creator's own character cards only).
    match /animeCharacters/{uid}/{characterId}/{file} {
      allow read: if true;
      allow write: if isOwner(uid) && isSafeImage() && isUnder10MB();
    }

    // Creator-supplied audio for the video editor. Audio is NOT isSafeImage(),
    // so it gets its own explicit allowlist — and deliberately no SVG/HTML
    // adjacency: the browser only ever loads these into an <audio> element.
    match /animeProjects/{uid}/{projectId}/audio/{file} {
      allow read: if true;
      allow write: if isOwner(uid)
        && request.resource.contentType.matches('audio/(mpeg|mp3|wav|ogg|webm|aac|m4a|x-m4a)')
        && isUnder25MB();
    }

    // ── Private workspace ─────────────────────────────────────
    // Generated video and private drafts. NO client access in either direction,
    // not even for the owner: reads go through /api/anime/assets, which checks
    // ownership server-side and mints a SHORT-LIVED signed URL. Writes are
    // Admin-SDK only (the generation pipeline), so a client can never place
    // bytes at a path a scene's storageKey could later point at.
    //
    // This denial is what makes "no permanent public URL for private work"
    // structural: there is no download token to leak, because no client can
    // ever obtain one for this prefix.
    match /private/{allPrivate=**} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
